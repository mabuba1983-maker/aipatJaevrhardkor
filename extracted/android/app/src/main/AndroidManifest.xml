<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- INTERNET is used ONLY by the optional Google-search feature (GoogleSearch.kt), which runs only when the user explicitly asks for it
         and only after the user supplies their own API key. Nothing else in the app uses the network; it is otherwise fully offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="نواة" android:supportsRtl="true" android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".ScreenShareService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
        <service android:name=".ScreenReader" android:exported="false" android:label="نواة (قارئ الشاشة)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config"/>
        </service>
    </application>
</manifest>
