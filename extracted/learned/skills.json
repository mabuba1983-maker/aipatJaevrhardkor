 words"], "level": 1, "n_cases": 12, "in_type": "str"}, {"id": "sum_even", "in_types": ["list"], "out_type": "int", "expr": ["sum", ["keep_even", ["x"]]], "desc": ["مجموع الأرقام الزوجية", "sum of the even numbers"], "level": 2, "n_cases": 12, "in_type": "list"}, {"id": "sq_of_odds", "in_types": ["list"], "out_type": "int", "expr": ["skill:sum_sq", ["keep_odd", ["x"]]], "desc": ["مجموع مربعات الأرقام الفردية", "sum of squares of odd numbers"], "level": 2, "n_cases": 12, "in_type": "list"}, {"id": "count_pos", "in_types": ["list"], "out_type": "int", "expr": ["len_list", ["keep_pos", ["x"]]], "desc": ["كم رقم موجب", "count positive numbers"], "level": 2, "n_cases": 12, "in_type": "list"}, {"id": "avg_floor", "in_types": ["list"], "out_type": "int", "expr": ["fdiv", ["sum", ["x"]], ["len_list", ["x"]]], "desc": ["المتوسط الصحيح للقائمة", "integer average"], "level": 2, "n_cases": 12, "in_type": "list"}, {"id": "span_sq", "in_types": ["list"], "out_type": "int", "expr": ["skill:span", ["map_sq", ["x"]]], "desc": ["الفرق بين أكبر وأصغر مربع", "span of the squares"], "level": 2, "n_cases": 12, "in_type": "list"}, {"id": "upper_rev", "in_types": ["str"], "out_type": "str", "expr": ["rev_s", ["upper", ["x"]]], "desc": ["اعكس النص ثم كبّر الحروف", "reverse then uppercase"], "level": 2, "n_cases": 12, "in_type": "str"}, {"id": "longest_word", "in_types": ["str"], "out_type": "int", "expr": ["max", ["map_len", ["split", ["x"]]]], "desc": ["طول أطول كلمة", "length of the longest word"], "level": 2, "n_cases": 12, "in_type": "str"}, {"id": "sum_sorted_top2", "in_types": ["list"], "out_type": "int", "expr": ["add", ["max", ["x"]], ["skill:second_largest", ["x"]]], "desc": ["مجموع أكبر رقمين", "sum of the two largest"], "level": 3, "n_cases": 12, "in_type": "list"}, {"id": "range_of_evens", "in_types": ["list"], "out_type": "int", "expr": ["skill:span", ["keep_even", ["x"]]], "desc": ["الفرق بين أكبر وأصغر زوجي", "span of the even numbers"], "level": 3, "n_cases": 12, "in_type": 